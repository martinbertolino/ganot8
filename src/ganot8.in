#!@PYTHON@
"""Ganot8 launcher, generated by Meson with this installation's paths."""

import os
import sys

sys.path.insert(1, "@PKGLIBDIR@")

# Where resources.py looks for the GResource bundle. Set rather than guessed,
# because the installation prefix is only known at configure time.
os.environ.setdefault("GANOT8_RESOURCE_DIR", "@PKGDATADIR@")

if __name__ == "__main__":
    from ganot8.app import main

    sys.exit(main(sys.argv))
