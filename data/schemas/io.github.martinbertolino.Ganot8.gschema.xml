<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="io.github.martinbertolino.Ganot8" path="/io/github/martinbertolino/Ganot8/">

    <key name="window-width" type="i">
      <default>1200</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>800</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Whether the window was maximized</summary>
    </key>
    <key name="sidebar-visible" type="b">
      <default>true</default>
      <summary>Whether the style sidebar is shown</summary>
    </key>

    <key name="export-format" type="s">
      <default>'PNG'</default>
      <summary>Last used export format</summary>
    </key>
    <key name="export-quality" type="i">
      <range min="10" max="100"/>
      <default>92</default>
      <summary>Quality for lossy export formats</summary>
    </key>

    <key name="tool-styles" type="s">
      <default>'{}'</default>
      <summary>Last used style per tool, as JSON</summary>
      <description>
        Stored as a JSON object rather than as separate keys because the set of
        tools, and the properties each one has, change as annotation kinds are
        added. A schema change for every new kind would be the wrong trade.
      </description>
    </key>

  </schema>
</schemalist>
