<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <!--
    The symbolic tool icons, bundled so they travel with the binary.
    GTK finds icons under a resource path the same way it finds them in a
    theme directory, which means an installed build does not depend on the
    icon cache having been refreshed.
  -->
  <gresource prefix="/io/github/martinbertolino/Ganot8/icons">
    <file preprocess="xml-stripblanks">scalable/actions/ganot8-select-symbolic.svg</file>
    <file preprocess="xml-stripblanks">scalable/actions/ganot8-highlight-symbolic.svg</file>
    <file preprocess="xml-stripblanks">scalable/actions/ganot8-redact-symbolic.svg</file>
    <file preprocess="xml-stripblanks">scalable/actions/ganot8-ellipse-symbolic.svg</file>
    <file preprocess="xml-stripblanks">scalable/actions/ganot8-badge-symbolic.svg</file>
    <file preprocess="xml-stripblanks">scalable/actions/ganot8-crop-symbolic.svg</file>
  </gresource>
</gresources>
